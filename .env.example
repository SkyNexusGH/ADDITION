# Copy to .env.local before building/dev. .env.local is gitignored.
#
# CurseForge API key — embedded at build time so end-users don't have to
# register their own. Get one at https://console.curseforge.com.
# If absent, the mod browser will still run with whatever key the user
# enters in Settings → API Keys.
VITE_CURSEFORGE_API_KEY=
